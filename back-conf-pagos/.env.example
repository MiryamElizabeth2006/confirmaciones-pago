# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Clave para el área de administrador (obligatoria para usar /admin/*)
ADMIN_API_KEY=tu-clave-secreta-admin

# Base de datos PostgreSQL (requerido para Prisma)
# Ejemplo: postgresql://usuario:password@localhost:5432/confirmaciones_pago
DATABASE_URL="postgresql://usuario:password@localhost:5432/confirmaciones_pago"

# Proveedor de extracción de datos del comprobante: textract (AWS, gratuito) | mock | openai
# Por defecto: textract (AWS Textract, free tier)
VISION_PROVIDER=textract

# AWS Textract (gratuito en free tier: 1000 páginas/mes primeros 3 meses)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Opcional: API Key de OpenAI solo si VISION_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Usar modo mock (sin llamar a ningún servicio): true para probar sin créditos
# OPENAI_USE_MOCK=true
# MOCK_NUMERO_DOCUMENTO=3314892
# MOCK_MONTO=30
# MOCK_FECHA=2025/DIC/02 14H27
# MOCK_NOMBRE_CUENTA_DESTINO=Nombre cuenta destino

# Ruta absoluta o relativa al archivo Excel de pagos (opcional)
# Por defecto: ./data/pagos.xlsx
# EXCEL_PAGOS_PATH=./data/pagos.xlsx
