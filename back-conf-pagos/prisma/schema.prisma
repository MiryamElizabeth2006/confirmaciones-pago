generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Estudiante {
  id           String   @id @default(uuid()) @db.Uuid
  cedula       String   @unique
  nombre       String
  generacion   String   @default("Generación 3")

  moduloId     String   @db.Uuid
  modulo       Modulo   @relation(fields: [moduloId], references: [id])

  comprobantes ComprobantePago[]
  pagos        HistorialPago[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Modulo {
  id           String   @id @default(uuid()) @db.Uuid
  nombre       String
  monto        Decimal  @default(287.50) @db.Decimal(10,2)

  estudiantes  Estudiante[]
  comprobantes ComprobantePago[]
  pagos        HistorialPago[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ComprobantePago {
  id                String   @id @default(uuid()) @db.Uuid

  estudianteId      String   @db.Uuid
  moduloId          String   @db.Uuid

  estudiante        Estudiante @relation(fields: [estudianteId], references: [id])
  modulo            Modulo     @relation(fields: [moduloId], references: [id])

  urlImagen         String

  documento         String?
  numeroTransaccion String?
  fechaPago         DateTime
  monto             Decimal   @db.Decimal(10,2)
  cuentaDestino     String?

  confirmacionPago  EstadoConfirmacion @default(PENDIENTE)

  // 🔹 relación con los abonos generados por este comprobante
  pagosGenerados    HistorialPago[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model HistorialPago {
  id             String   @id @default(uuid()) @db.Uuid

  estudianteId   String   @db.Uuid
  moduloId       String   @db.Uuid
  comprobanteId  String   @db.Uuid

  estudiante     Estudiante     @relation(fields: [estudianteId], references: [id])
  modulo         Modulo         @relation(fields: [moduloId], references: [id])
  comprobante    ComprobantePago @relation(fields: [comprobanteId], references: [id])

  montoAbonado   Decimal  @db.Decimal(10,2)
  fechaAbono     DateTime @default(now())
  saldoFaltante  Decimal  @db.Decimal(10, 2)

  createdAt      DateTime @default(now())
}

enum EstadoConfirmacion {
  PENDIENTE
  REALIZADO
  NO_REALIZADO
}
